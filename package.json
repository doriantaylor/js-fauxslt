{
  "name": "fauxslt",
  "version": "1.0.0",
  "description": "A basic template processor with XSLT-like behaviour",
  "keywords": [
    "template",
    "xslt"
  ],
  "homepage": "https://github.com/doriantaylor/js-fauxslt#readme",
  "bugs": {
    "url": "https://github.com/doriantaylor/js-fauxslt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doriantaylor/js-fauxslt.git"
  },
  "license": "Apache-2.0",
  "author": "Dorian Taylor",
  "type": "module",
  "main": "dist/fauxslt.js",
  "exports": {
    ".": "./dist/fauxslt.js"
  },
  "files": [
    "dist/fauxslt.js",
    "src/"
  ],
  "scripts": {
    "build:parser": "peggy --format es -o src/xpath-pattern.js src/xpath-pattern.peggy",
    "build:bundle": "esbuild src/index.js --bundle --format=esm --external:markup-mixup --outfile=dist/fauxslt.js",
    "build:minify": "esbuild src/index.js --bundle --format=esm --external:markup-mixup --minify --outfile=dist/fauxslt.min.js",
    "build": "pnpm build:parser && pnpm build:bundle && pnpm build:minify",
    "test:unit": "node --test test/pattern.test.js test/template.test.js test/expressions.test.js",
    "test": "pnpm build && playwright test && node --test test/pattern.test.js test/template.test.js test/expressions.test.js"
  },
  "dependencies": {
    "markup-mixup": "file:../js-markup-mixup"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "peggy": "^5.1.1",
    "playwright": "^1.64.1",
    "serve": "^14.2.6"
  }
}